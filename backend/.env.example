# Copy to backend/.env and fill in. Never commit backend/.env.

# Gemma (hosted Gemma 4 through the Gemini API, same as the original server.py).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemma-4-26b-a4b-it (faster) or gemma-4-31b-it (stronger)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Grok Voice briefing (xAI Text to Speech, POST https://api.x.ai/v1/tts).
# Docs: https://docs.x.ai/developers/model-capabilities/audio/text-to-speech
# The briefing button turns on as soon as this is set; no restart needed.
XAI_API_KEY=
# Voice id from the docs (eve, ara, rex, sal, leo, ...). Default: eve
XAI_VOICE_ID=eve

# true = serve every request from backend/cache only (no network). Same as key O in the UI.
DEMO_MODE=false

# Optional: contact email added to the User-Agent sent to NWS, Nominatim, and Overpass.
CONTACT_EMAIL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
